{
  "name": "pi-better-pstack",
  "version": "0.15.46",
  "private": true,
  "description": "Pi package for cursor/plugins/pstack: pristine upstream mirror with a mandatory Pi execution contract, mode injection, and configurable fable/opus/sonnet/haiku model presets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WufeiHalf/pi-better-pstack.git"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "agent-skills",
    "subagents"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "subagents": {
    "agents": [
      "./agents"
    ]
  },
  "scripts": {
    "sync": "node scripts/sync-pstack.mjs --fetch",
    "check:sync": "node scripts/sync-pstack.mjs --check",
    "test": "node --test test/*.test.mjs",
    "smoke": "node --test test/discovery.test.mjs",
    "check:compat": "npm run check:sync && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
